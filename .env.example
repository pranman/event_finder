# Local development configuration. Bootstrap creates .env with a unique secret.
# For manual setup, copy this file to .env and fill in DJANGO_SECRET_KEY.
# Exported environment variables take precedence over this file.
# Never commit .env or reuse a development key in production.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true

# Comma-separated hostnames; no schemes or ports. Required when DEBUG=false.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Only needed for trusted cross-origin requests. Include http(s):// and optional
# port, but no path or trailing slash. For example: https://app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Production: use a unique random secret, DEBUG=false and your actual hostnames.
# The following HTTPS settings default to true when DEBUG=false and false when
# DEBUG=true. Uncomment only to override the defaults for your deployment.
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true

# HSTS is opt-in. Start with a short duration after verifying HTTPS works.
# Enable include-subdomains only if ALL subdomains support HTTPS; preload is a
# separate long-term commitment. These defaults intentionally produce deployment
# check warnings until your deployment policy is explicitly configured.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# Enable only behind YOUR trusted reverse proxy that strips incoming
# X-Forwarded-Proto and sets it from the actual client protocol. Restrict direct
# access to Django; otherwise clients could spoof HTTPS. Default: false.
DJANGO_TRUST_X_FORWARDED_PROTO=false

# Optional: npm is found on PATH automatically (npm.cmd on Windows). An explicit
# executable path may contain spaces; quote it in .env, without embedding quotes
# in the value. Relative paths resolve from the repository root. Leave unset on
# servers that only serve prebuilt assets; Django startup does not require Node.
# NPM_BIN_PATH="/path with spaces/to/npm"

# Optional legacy digest integrations (unused by the web catalogue)
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ──────────────────────────────────────────────

# Gmail — use an App Password, NOT your regular password
# Guide: myaccount.google.com → Security → App Passwords
GMAIL_SENDER=your-email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here

# Eventbrite — free API key at: https://www.eventbrite.com/platform/api
EVENTBRITE_API_KEY=

# Songkick — free API key at: https://www.songkick.com/developer
SONGKICK_API_KEY=

# Reddit — free app at: https://www.reddit.com/prefs/apps (script type)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=events_finder/1.0 by your-username

# Meetup — OAuth token from: https://secure.meetup.com/meetup_api/oauth_consumers/
MEETUP_API_KEY=

# OpenAI — for LLM extraction (Reddit posts, BlogTO, unstructured text)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Luma — optional, for private calendars you follow
# Leave blank to use public discovery API
LUMA_API_KEY=
