# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ──────────────────────────────────────────────

# Gmail — use an App Password, NOT your regular password
# Guide: myaccount.google.com → Security → App Passwords
GMAIL_SENDER=your-email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here

# Eventbrite — free API key at: https://www.eventbrite.com/platform/api
EVENTBRITE_API_KEY=

# Songkick — free API key at: https://www.songkick.com/developer
SONGKICK_API_KEY=

# Reddit — free app at: https://www.reddit.com/prefs/apps (script type)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=events_finder/1.0 by your-username

# Meetup — OAuth token from: https://secure.meetup.com/meetup_api/oauth_consumers/
MEETUP_API_KEY=

# OpenAI — for LLM extraction (Reddit posts, BlogTO, unstructured text)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Luma — optional, for private calendars you follow
# Leave blank to use public discovery API
LUMA_API_KEY=
